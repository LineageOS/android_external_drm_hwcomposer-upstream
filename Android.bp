cc_library_headers {
    name: "drm_hwcomposer_headers_upstream",
    vendor: true,
    export_include_dirs: ["."],
}

// =====================
// hwcomposer.drm.so
// =====================
cc_defaults {
    name: "hwcomposer.drm_upstream_defaults",

    shared_libs: [
        "drm_hwcomposer_atom_reporter_upstream",

        "libbase",
        "libcutils",
        "libdrm",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libsync",
        "libui",
        "libutils",
    ],

    static_libs: [
        "libaidlcommonsupport",
        "libdisplay_info_upstream",
    ],

    header_libs: [
        "drm_hwcomposer_headers_upstream",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],

    cppflags: [
        "-DHAS_LIBDISPLAY_INFO",
        "-DHAS_LIBSYNC",
    ],

    cpp_std: "gnu++17",

    relative_install_path: "hw",
    vendor: true,
}

filegroup {
    name: "drm_hwcomposer_fd_upstream",
    srcs: ["utils/fd.cpp"],
}

filegroup {
    name: "drm_hwcomposer_common_upstream",
    srcs: [
        "bufferinfo/BufferInfoGetter.cpp",
        "bufferinfo/BufferInfoMapperMetadata.cpp",

        "compositor/CompositionPlanner.cpp",
        "compositor/FlatteningController.cpp",
        "compositor/GenericCompositionPlanner.cpp",
        "compositor/LayerToPlaneJoiningPlan.cpp",

        "drm/DrmAtomicStateManager.cpp",
        "drm/DrmColorOp.cpp",
        "drm/DrmConnector.cpp",
        "drm/DrmCrtc.cpp",
        "drm/DrmDevice.cpp",
        "drm/DrmDisplayPipeline.cpp",
        "drm/DrmEncoder.cpp",
        "drm/DrmFbImporter.cpp",
        "drm/DrmHwc.cpp",
        "drm/DrmMode.cpp",
        "drm/DrmPlane.cpp",
        "drm/DrmProperty.cpp",
        "drm/ResourceManager.cpp",
        "drm/UEventListener.cpp",
        "drm/VSyncWorker.cpp",

        "backend/BackendManager.cpp",
        "backend/ClientBackend.cpp",
        "backend/GenericBackend.cpp",

        "hwc/HwcDisplay.cpp",
        "hwc/HwcDisplayConfigs.cpp",
        "hwc/HwcLayer.cpp",

        "stats/Stats.cpp",
        "stats/StatsPoller.cpp",

        "utils/LibdisplayEdidWrapper.cpp",
        "utils/fd.cpp",
        "utils/properties.cpp",
    ],
}

filegroup {
    name: "drm_hwcomposer_hwc2_upstream",
    srcs: [
        "hwc2_device/DrmHwcTwo.cpp",
        "hwc2_device/hwc2_device.cpp",
    ],
}

filegroup {
    name: "drm_hwcomposer_hwc3_upstream",
    srcs: [
        "hwc3/Composer.cpp",
        "hwc3/ComposerClient.cpp",
        "hwc3/DrmHwcThree.cpp",
    ],
}

filegroup {
    name: "drm_hwcomposer_service_upstream",
    srcs: [
        "hwc3/service.cpp",
    ],
}

filegroup {
    name: "drm_hwcomposer_init_rc_upstream",
    srcs: [
        "hwc3/hwc3-drm-upstream.rc",
    ],
}

filegroup {
    name: "drm_hwcomposer_vintf_manifest_upstream",
    srcs: [
        "hwc3/hwc3-drm-upstream.xml",
    ],
}

cc_defaults {
    name: "android.hardware.composer.hwc3-service.drm_upstream.defaults",

    srcs: [
        ":drm_hwcomposer_common_upstream",
        ":drm_hwcomposer_hwc3_upstream",
        ":drm_hwcomposer_service_upstream",
    ],

    defaults: [
        "hwcomposer.drm_upstream_defaults",
    ],

    shared_libs: [
        "android.hardware.graphics.composer3-V4-ndk",
        "libbase",
        "libbinder_ndk",
        "liblog",
        "libutils",
    ],

    cflags: [
        "-DUSE_IMAPPER4_METADATA_API",
        "-Wall",
        "-Werror",
    ],
}

cc_binary {
    name: "android.hardware.composer.hwc3-service.drm_upstream",

    defaults: [
        "android.hardware.composer.hwc3-service.drm_upstream.defaults",
    ],

    srcs: ["bufferinfo/legacy/BufferInfoLibdrm.cpp"],

    relative_install_path: "hw",
    vendor: true,

    vintf_fragments: select(soong_config_variable("drm_hwcomposer_upstream", "include_vintf_fragments"), {
        false: [],
        default: [":drm_hwcomposer_vintf_manifest_upstream"],
    }),
    init_rc: select(soong_config_variable("drm_hwcomposer_upstream", "include_init_rc"), {
        false: [],
        default: [":drm_hwcomposer_init_rc_upstream"],
    }),
}

// Used by hwcomposer.drm_imagination
filegroup {
    name: "drm_hwcomposer_platformimagination_upstream",
    srcs: ["bufferinfo/legacy/BufferInfoImagination.cpp"],
}

// Used by hwcomposer.drm_hikey and hwcomposer.drm_hikey960
filegroup {
    name: "drm_hwcomposer_platformhisi_upstream",
    srcs: ["bufferinfo/legacy/BufferInfoMaliHisi.cpp"],
}

// Used by hwcomposer.drm_meson
filegroup {
    name: "drm_hwcomposer_platformmeson_upstream",
    srcs: ["bufferinfo/legacy/BufferInfoMaliMeson.cpp"],
}

// Used by hwcomposer.drm_mediatek
filegroup {
    name: "drm_hwcomposer_platformmediatek_upstream",
    srcs: ["bufferinfo/legacy/BufferInfoMaliMediatek.cpp"],
}

prebuilt_etc {
    name: "drm_hwcomposer_hwc3_apex_vintf_upstream",
    src: "hwc3/hwc3-drm-upstream.xml",
    sub_dir: "vintf",
    vendor: true,
    installable: false,
}

prebuilt_etc {
    name: "drm_hwcomposer_hwc3_apex_init_rc_upstream",
    filename_from_src: true,
    vendor: true,
    src: ":gen-drm_hwcomposer_hwc3_apex_init_rc_upstream",
}

genrule {
    name: "gen-drm_hwcomposer_hwc3_apex_init_rc_upstream",
    srcs: ["hwc3/hwc3-drm-upstream.rc"],
    out: ["hwc3-drm-upstream.apex.rc"],
    cmd: "sed " +
        // Update the binary location to inside the Apex:
        "-e 's%/vendor/bin/%/apex/com.android.hardware.graphics.composer/bin/%' " +
        "$(in) > $(out)",
}

filegroup {
    name: "drm_hwcomposer_hwc3_apex_file_contexts_upstream",
    srcs: [
        "hwc3/hwc3-apex-file-contexts",
    ],
}

filegroup {
    name: "drm_hwcomposer_hwc3_apex_manifest_upstream",
    srcs: [
        "hwc3/hwc3-apex-manifest.json",
    ],
}

apex {
    name: "com.android.hardware.graphics.composer.drm_hwcomposer_upstream",
    key: "com.android.hardware.key",
    certificate: ":com.android.hardware.certificate",
    file_contexts: ":drm_hwcomposer_hwc3_apex_file_contexts_upstream",
    manifest: ":drm_hwcomposer_hwc3_apex_manifest_upstream",
    vendor: true,
    updatable: false,
    soc_specific: true,
    binaries: [
        "android.hardware.composer.hwc3-service.drm_upstream",
    ],
    prebuilts: [
        "drm_hwcomposer_hwc3_apex_init_rc_upstream",
        "drm_hwcomposer_hwc3_apex_vintf_upstream",
    ],
}

cc_test_host {
    name: "drm_hwcomposer_unittests_upstream",
    srcs: [
        "bufferinfo/BufferInfoGetter.cpp",
        "compositor/FlatteningController.cpp",
        "compositor/FlatteningControllerTests.cpp",
        "compositor/FlatteningEventAtomReporter.cpp",
        "drm/DrmAtomicStateManager.cpp",
        "drm/DrmColorOp.cpp",
        "drm/DrmConnector.cpp",
        "drm/DrmCrtc.cpp",
        "drm/DrmDevice.cpp",
        "drm/DrmDisplayPipeline.cpp",
        "drm/DrmDisplayPipelineTest.cpp",
        "drm/DrmEncoder.cpp",
        "drm/DrmMode.cpp",
        "drm/DrmPlane.cpp",
        "drm/DrmProperty.cpp",
        "stats/Stats.cpp",
        "stats/StatsTest.cpp",
        "utils/fd.cpp",
        "utils/properties.cpp",
    ],
    static_libs: [
        "libbase",
        "libcutils",
        "libdrm",
        "libgmock",
        "libgtest",
        "liblog",
    ],
    shared_libs: [
        "libhardware",
    ],
}

soong_config_module_type {
    name: "drm_hwcomposer_atom_reporter_library_upstream",
    module_type: "cc_library",
    config_namespace: "DRMHWC",
    variables: [
        "atom_reporter",
    ],
    properties: [
        "shared_libs",
        "srcs",
    ],
}

soong_config_string_variable {
    name: "atom_reporter",
    values: ["desktop"],
}

drm_hwcomposer_atom_reporter_library_upstream {
    name: "drm_hwcomposer_atom_reporter_upstream",
    srcs: [
        "compositor/FlatteningController.cpp",
    ],
    shared_libs: [
        "libbase",
        "libc++",
        "libdrm",
        "libhardware",
        "liblog",
    ],
    soong_config_variables: {
        atom_reporter: {
            desktop: {
                srcs: [
                    "compositor/FlatteningEventAtomReporterDesktop.cpp",
                    "stats/CompositionStatsAtomReporterDesktop.cpp",
                    "stats/CountActiveDisplaysReporterDesktop.cpp",
                    "stats/DisplayHotplugConnectModeDetectedAtomReporterDesktop.cpp",
                    "stats/DisplayRefreshRatesChangedAtomReporterDesktop.cpp",
                ],
                shared_libs: [
                    "android.frameworks.stats-V2-ndk",
                    "libbinder_ndk",
                    "libdesktopatoms",
                ],
            },
            conditions_default: {
                srcs: [
                    "compositor/FlatteningEventAtomReporter.cpp",
                    "stats/CompositionStatsAtomReporter.cpp",
                    "stats/CountActiveDisplaysReporter.cpp",
                    "stats/DisplayHotplugConnectModeDetectedAtomReporter.cpp",
                    "stats/DisplayRefreshRatesChangedAtomReporter.cpp",
                ],
            },
        },
    },
    vendor: true,
}
